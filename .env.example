# Copier en .env (jamais commité). Les secrets utilisés par la CI sont aussi
# déclarés comme secrets de dépôt (github-setup.sh secrets).

# Jeton Hugging Face : lecture du dépôt modèle privé (au démarrage du service) et écriture
# du Space (déploiement). Secret de l'environnement GitHub ml-models et du Space.
HF_TOKEN=

# Clé d'API attendue dans l'en-tête X-API-Key (ADR-003) — secret du Space et de la CI
API_KEY=

# Base des journaux de production (Neon, région UE ; #16). Absente : journaux sur stdout
# seulement. En local, `neon env pull` l'écrit dans .env.local (ignoré par git).
DATABASE_URL=

# Dossier des artefacts du modèle (défaut : artifacts/)
MODEL_DIR=artifacts
